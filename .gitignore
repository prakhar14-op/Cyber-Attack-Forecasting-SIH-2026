# Never commit model weights or captures (use GitHub Releases + SHA-256 in README)
weights/
*.pcap
*.pcapng
*.pt
*.pth
*.keras
.DS_Store
._*

# Raw dataset downloads and derived artifacts
data/raw/
data/interim/
data/processed/
artifacts/
results/

# Offline wheel-house (rebuilt by scripts/build_vendor.ps1; too large for git)
vendor/*.whl
vendor/*.tar.gz

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# OS / editor noise
.DS_Store
Thumbs.db

# Generated engine output (ledger, checkpoints, forecasts) — never committed
run/
# Local Claude Code settings (launch.json is kept; personal settings are not)
.claude/settings.local.json

# Anonymisation key (never committed — CLAUDE.md); set SIH26_HMAC_KEY from here
.env

# The synthetic demo capture IS bundled (small, deterministic, illustrative —
# regenerable via `python -m capture.make_synthetic_demo`). NOT real capture data.
!app/assets/synthetic_demo.pcap

# Diagnostic data caches (regenerable; the committed evidence is the .png/.json)
diagnostics/*.npz

# Frontend: dependencies and build output are regenerable from package-lock.json.
# NOTE: frontend/node_modules and frontend/dist are currently TRACKED from an
# earlier commit. These rules stop NEW files being added; to stop tracking the
# existing ones run (this removes them from the index only, not from disk):
#   git rm -r --cached frontend/node_modules frontend/dist
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

.DS_Store
._*
